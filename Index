      <td><div style="display:flex;align-items:center;gap:7px"><div class="av" style="background:${o.color};color:var(--slate)">${o.ini}</div><span style="font-weight:500">${o.name}</span></div></td>
      <td style="font-size:11px">${o.site}</td>
      <td><span class="pill pill-gray" style="font-size:9px">${o.role}</span></td>
      <td style="text-align:right;font-family:'DM Mono',monospace">${o.audits}</td>
      <td style="text-align:right;font-family:'DM Mono',monospace">${o.reports>0?`<span class="pill pill-red">${o.reports}</span>`:o.reports}</td>
      <td style="text-align:right;font-family:'DM Mono',monospace">${o.fails>0?`<span class="fail-badge">${o.fails}</span>`:'0'}</td>
      <td style="font-size:11px;color:var(--muted)">Today</td>
    </tr>`).join('');

  DC('dayOfWeek');
  AC['dayOfWeek']=new Chart(document.getElementById('chartDayOfWeek'),{type:'bar',
    data:{labels:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],datasets:[{data:[188,181,192,186,175,82,73],backgroundColor:['#1e6fff','#1e6fff','#1e6fff','#1e6fff','#1e6fff','#93c5fd','#93c5fd'],borderRadius:3,borderWidth:0}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},y:{grid:{color:'#f1f5f9'}}}}});

  const maxV=Math.max(...OFFICERS.map(o=>o.audits+o.reports));
  document.getElementById('topOfficers').innerHTML=OFFICERS.slice(0,6).map(o=>`
    <div class="mbar-row" style="margin-bottom:8px">
      <span class="mbar-lbl" style="width:100px">${o.name}</span>
      <div class="mbar-track"><div class="mbar-fill" style="width:${Math.round((o.audits+o.reports)/maxV*100)}%;background:#1e6fff"></div></div>
      <span class="mbar-cnt">${o.audits+o.reports}</span>
    </div>`).join('');
}

window.addEventListener('load',()=>initP1());
</script>
</body>
</html>
