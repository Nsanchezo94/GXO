// ── NAV ───────────────────────────────────────────────────────
function switchPage(id,btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
  document.getElementById('page-title').textContent=pageTitles[id];
  document.getElementById('page-crumb').textContent=getCrumb();
  setTimeout(()=>initPage(id),40);
}
function getCrumb(){
  const s=document.getElementById('f-site').value;
  const f=document.getElementById('f-form').value;
  const c=document.getElementById('f-cat').value;
  const parts=[];
  if(s!=='all') parts.push(SITES.find(x=>x.id===s)?.name||s);
  else parts.push('All sites');
  if(f!=='all') parts.push('Form: GXO-G-'+f);
  else if(c!=='all') parts.push('Cat: '+c);
  else parts.push('All forms');
  return parts.join(' · ');
}
function applyFilters(){
  const p=document.getElementById('f-period').value;
  const lbl={may26:'May 2026',apr26:'April 2026',q1:'Q1 2026',last30:'Last 30 days'};
  document.getElementById('period-display').textContent=lbl[p];
  document.getElementById('page-crumb').textContent=getCrumb();
  const active=document.querySelector('.page.active')?.id;
  if(active) setTimeout(()=>initPage(active),30);
}
function initPage(id){
  if(id==='p1') initP1();
  if(id==='p2') initP2();
  if(id==='p3') initP3();
  if(id==='p4') initP4();
  if(id==='p5') initP5();
}

